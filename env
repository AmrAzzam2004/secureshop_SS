# SecureShop environment settings
# These are the ONLY environment variables the app reads (see config.py).
# Format: NAME=value   (lines starting with # are comments)

# Secret key that signs the session cookie. Keep it private and never commit it to Git.
# If it is missing, the app makes a random one at each start (everyone gets logged out on restart).
SECRET_KEY=""create 256 hash key from any website""

# Database location. Default: secureshop.db (SQLite) in the project folder.
DATABASE_URL=sqlite:///secureshop.db

# 1 = cookies only sent over HTTPS (use when you run with HTTPS). 0 = local http://127.0.0.1
COOKIE_SECURE=0
